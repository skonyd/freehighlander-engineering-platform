{
  "name": "freehighlander-engineering-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write apps/control-plane/test/project-workspace-scheduling.test.mjs && git diff -- apps/control-plane/test/project-workspace-scheduling.test.mjs && exit 1",
    "format:write": "prettier --write package.json tsconfig.base.json .prettierrc.json apps packages tools .github/workflows/fh-ci.yml",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test tools/project/test/*.test.mjs",
    "check:architecture": "node tools/project/check-architecture.mjs",
    "project:bootstrap": "node tools/project/bootstrap.mjs",
    "project:doctor": "node tools/project/doctor.mjs",
    "project:resume": "node tools/project/resume.mjs",
    "project:checkpoint": "node tools/project/checkpoint.mjs",
    "project:context": "node tools/project/context.mjs",
    "project:portable-resume": "npm run build -w @freehighlander/governance -w @freehighlander/orchestration -w @freehighlander/persistence && node tools/project/portable-resume.mjs",
    "project:architecture": "node tools/project/architecture.mjs",
    "dashboard:start": "npm run start -w @freehighlander/web",
    "models": "npm run build -w @freehighlander/model-runtime -w @freehighlander/persistence && node tools/project/models.mjs",
    "verify": "npm run format && npm run typecheck && npm run build && npm run test && npm run check:coverage && npm run check:build-integrity && npm run check:build-completeness && npm run check:dependencies && npm run check:workspace-resolution && npm run check:entrypoints && npm run check:docs && npm run check:ci && npm run check:lockfile && npm run check:publish-safety && npm run check:secrets && npm run check:architecture && npm run project:doctor",
    "check:dependencies": "node tools/project/check-dependencies.mjs",
    "check:docs": "node tools/project/check-doc-drift.mjs",
    "check:ci": "node tools/project/check-ci-supply-chain.mjs",
    "check:secrets": "node tools/project/check-secrets.mjs",
    "check:coverage": "node tools/project/check-coverage.mjs",
    "check:lockfile": "node tools/project/check-lockfile.mjs",
    "check:build-integrity": "node tools/project/check-build-integrity.mjs",
    "check:publish-safety": "node tools/project/check-publish-safety.mjs",
    "check:workspace-resolution": "node tools/project/check-workspace-resolution.mjs",
    "check:entrypoints": "node tools/project/check-entrypoints.mjs",
    "check:build-completeness": "node tools/project/check-build-completeness.mjs",
    "secrets": "npm run build -w @freehighlander/governance -w @freehighlander/persistence && node tools/project/secrets.mjs",
    "project:portable-resume-bootstrap": "node tools/project/portable-resume-bootstrap.mjs",
    "fh": "node tools/fh.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "bin": {
    "fh": "tools/fh.mjs"
  }
}
